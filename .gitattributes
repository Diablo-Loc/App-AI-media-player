# Audio regression gates deliberately compare exact reviewed source bytes.
# Preserve mixed/LF/CRLF snapshots instead of core.autocrlf rewriting them.
docs/audio-*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/**/original/** -text whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
app/control/audio_*.py -text
app/core/audio_*.py -text
app/ui/audio_effects_panel.py -text
app/ui/subtitle_presentation.py -text
app/ui/assets/icons/*.svg -text
tests/test_audio_*.py -text
app/test/test_aligner_optimizations.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Archives reproduce old source/patch whitespace verbatim, including old blanks.
docs/audio-*/original/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
docs/audio-effects/import-compatibility/** whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
