docs/audio-*/reviewed.patch whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol
# Generated diagnostic evidence, not maintained production source.
docs/audio-*/*.txt whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab,cr-at-eol

