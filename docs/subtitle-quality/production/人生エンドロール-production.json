[
  {
    "start": 5.43,
    "end": 8.94,
    "text": "くだらない人生の最後の一手"
  },
  {
    "start": 9.95,
    "end": 14.16,
    "text": "エンドロールに名前がなくとも"
  },
  {
    "start": 28.71,
    "end": 29.66,
    "text": "壊れた"
  },
  {
    "start": 29.95,
    "end": 36.75,
    "text": "息を吸って解けた靴紐を結んだ理屈な言葉あたり"
  },
  {
    "start": 36.75,
    "end": 43.64,
    "text": "でも足を止めないよつるぼけた地図を頼りにいこう"
  },
  {
    "start": 44.65,
    "end": 49.52,
    "text": "隣の芝生が青く見えても"
  },
  {
    "start": 51.03,
    "end": 57.17,
    "text": "走り最低限でも止まらなきゃそれでいいから後ろ"
  },
  {
    "start": 57.17,
    "end": 64.17,
    "text": "で指差す奴らはほっとけ消失な人生なんてもう特"
  },
  {
    "start": 64.17,
    "end": 71.17,
    "text": "に諦めたらエンドロールなんかじゃない生き様で"
  },
  {
    "start": 71.17,
    "end": 73.0,
    "text": "刻んでやれ"
  },
  {
    "start": 81.81,
    "end": 87.16,
    "text": "一人がいいってどこか強がってみせた"
  },
  {
    "start": 87.77,
    "end": 92.64,
    "text": "主人公じゃないから見合わないのに"
  },
  {
    "start": 93.1,
    "end": 100.89,
    "text": "けれど千点万か正解はいいぞそう都合主義ならま"
  },
  {
    "start": 100.89,
    "end": 103.04,
    "text": "かり通すだよ"
  },
  {
    "start": 104.39,
    "end": 109.45,
    "text": "二重人生なんかそういうものっては生きらないで"
  },
  {
    "start": 109.45,
    "end": 116.73,
    "text": "泥まみれの生き方でもいいんだ大それた才能なん"
  },
  {
    "start": 116.73,
    "end": 122.41,
    "text": "てこっちからお断りだバードエンドなんかじゃない"
  },
  {
    "start": 122.41,
    "end": 130.36,
    "text": "それなりの幸せで決められたレールを保っても"
  },
  {
    "start": 130.75,
    "end": 136.21,
    "text": "悪くはないんだろうけどそれだけじゃつまらない"
  },
  {
    "start": 136.21,
    "end": 136.76,
    "text": "から"
  },
  {
    "start": 157.91,
    "end": 164.29,
    "text": "走れ最低限でも止まらなくそれでいいから後ろで"
  },
  {
    "start": 164.29,
    "end": 171.57,
    "text": "指さす奴らはほっとけ上質な人生なんてもう特に"
  },
  {
    "start": 171.57,
    "end": 178.37,
    "text": "諦めたらエンドロールなんかじゃない生き様で刻"
  },
  {
    "start": 178.37,
    "end": 180.08,
    "text": "んでやれ"
  },
  {
    "start": 183.89,
    "end": 188.0,
    "text": "くだらない人生の最後の一手を"
  },
  {
    "start": 189.63,
    "end": 190.44,
    "text": "今"
  }
]