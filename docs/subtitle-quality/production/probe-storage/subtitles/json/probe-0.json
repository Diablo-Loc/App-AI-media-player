{
  "media_id": "probe-0",
  "original_name": "人生エンドロール",
  "segments": [
    {
      "start": 5.43,
      "end": 8.94,
      "jp": "くだらない人生の最後の一手",
      "en": "",
      "vi": ""
    },
    {
      "start": 9.95,
      "end": 14.16,
      "jp": "エンドロールに名前がなくとも",
      "en": "",
      "vi": ""
    },
    {
      "start": 28.71,
      "end": 29.66,
      "jp": "壊れた",
      "en": "",
      "vi": ""
    },
    {
      "start": 29.95,
      "end": 36.75,
      "jp": "息を吸って解けた靴紐を結んだ理屈な言葉あたり",
      "en": "",
      "vi": ""
    },
    {
      "start": 36.75,
      "end": 43.64,
      "jp": "でも足を止めないよつるぼけた地図を頼りにいこう",
      "en": "",
      "vi": ""
    },
    {
      "start": 44.65,
      "end": 49.52,
      "jp": "隣の芝生が青く見えても",
      "en": "",
      "vi": ""
    },
    {
      "start": 51.03,
      "end": 57.17,
      "jp": "走り最低限でも止まらなきゃそれでいいから後ろ",
      "en": "",
      "vi": ""
    },
    {
      "start": 57.17,
      "end": 64.17,
      "jp": "で指差す奴らはほっとけ消失な人生なんてもう特",
      "en": "",
      "vi": ""
    },
    {
      "start": 64.17,
      "end": 71.17,
      "jp": "に諦めたらエンドロールなんかじゃない生き様で",
      "en": "",
      "vi": ""
    },
    {
      "start": 71.17,
      "end": 73.0,
      "jp": "刻んでやれ",
      "en": "",
      "vi": ""
    },
    {
      "start": 81.81,
      "end": 87.16,
      "jp": "一人がいいってどこか強がってみせた",
      "en": "",
      "vi": ""
    },
    {
      "start": 87.77,
      "end": 92.64,
      "jp": "主人公じゃないから見合わないのに",
      "en": "",
      "vi": ""
    },
    {
      "start": 93.1,
      "end": 100.89,
      "jp": "けれど千点万か正解はいいぞそう都合主義ならま",
      "en": "",
      "vi": ""
    },
    {
      "start": 100.89,
      "end": 103.04,
      "jp": "かり通すだよ",
      "en": "",
      "vi": ""
    },
    {
      "start": 104.39,
      "end": 109.45,
      "jp": "二重人生なんかそういうものっては生きらないで",
      "en": "",
      "vi": ""
    },
    {
      "start": 109.45,
      "end": 116.73,
      "jp": "泥まみれの生き方でもいいんだ大それた才能なん",
      "en": "",
      "vi": ""
    },
    {
      "start": 116.73,
      "end": 122.41,
      "jp": "てこっちからお断りだバードエンドなんかじゃない",
      "en": "",
      "vi": ""
    },
    {
      "start": 122.41,
      "end": 130.36,
      "jp": "それなりの幸せで決められたレールを保っても",
      "en": "",
      "vi": ""
    },
    {
      "start": 130.75,
      "end": 136.21,
      "jp": "悪くはないんだろうけどそれだけじゃつまらない",
      "en": "",
      "vi": ""
    },
    {
      "start": 136.21,
      "end": 136.76,
      "jp": "から",
      "en": "",
      "vi": ""
    },
    {
      "start": 157.91,
      "end": 164.29,
      "jp": "走れ最低限でも止まらなくそれでいいから後ろで",
      "en": "",
      "vi": ""
    },
    {
      "start": 164.29,
      "end": 171.57,
      "jp": "指さす奴らはほっとけ上質な人生なんてもう特に",
      "en": "",
      "vi": ""
    },
    {
      "start": 171.57,
      "end": 178.37,
      "jp": "諦めたらエンドロールなんかじゃない生き様で刻",
      "en": "",
      "vi": ""
    },
    {
      "start": 178.37,
      "end": 180.08,
      "jp": "んでやれ",
      "en": "",
      "vi": ""
    },
    {
      "start": 183.89,
      "end": 188.0,
      "jp": "くだらない人生の最後の一手を",
      "en": "",
      "vi": ""
    },
    {
      "start": 189.63,
      "end": 190.44,
      "jp": "今",
      "en": "",
      "vi": ""
    }
  ]
}