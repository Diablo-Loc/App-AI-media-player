[
  {
    "start": 5.43,
    "end": 8.94,
    "text": "くだらない人生の最後の一手"
  },
  {
    "start": 9.95,
    "end": 14.16,
    "text": "エンドロールに名前がなくとも"
  },
  {
    "start": 28.71,
    "end": 29.66,
    "text": "壊れた"
  },
  {
    "start": 29.95,
    "end": 34.39,
    "text": "息を吸って解けた靴紐を結んだ"
  },
  {
    "start": 34.39,
    "end": 39.08,
    "text": "理屈な言葉あたりでも足を止めないよ"
  },
  {
    "start": 39.45,
    "end": 43.64,
    "text": "つるぼけた地図を頼りにいこう"
  },
  {
    "start": 44.65,
    "end": 49.52,
    "text": "隣の芝生が青く見えても"
  },
  {
    "start": 51.03,
    "end": 55.83,
    "text": "走り最低限でも止まらなきゃそれでいいから"
  },
  {
    "start": 55.83,
    "end": 61.17,
    "text": "後ろで指差す奴らはほっとけ"
  },
  {
    "start": 61.17,
    "end": 66.43,
    "text": "消失な人生なんてもう特に諦めたら"
  },
  {
    "start": 66.43,
    "end": 73.0,
    "text": "エンドロールなんかじゃない生き様で刻んでやれ"
  },
  {
    "start": 81.81,
    "end": 87.16,
    "text": "一人がいいってどこか強がってみせた"
  },
  {
    "start": 87.77,
    "end": 90.38,
    "text": "主人公じゃないから"
  },
  {
    "start": 90.53,
    "end": 92.64,
    "text": "見合わないのに"
  },
  {
    "start": 93.1,
    "end": 96.93,
    "text": "けれど千点万か正解はいいぞ"
  },
  {
    "start": 96.93,
    "end": 103.04,
    "text": "そう都合主義ならまかり通すだよ"
  },
  {
    "start": 104.39,
    "end": 109.45,
    "text": "二重人生なんかそういうものっては生きらないで"
  },
  {
    "start": 109.45,
    "end": 114.59,
    "text": "泥まみれの生き方でもいいんだ"
  },
  {
    "start": 114.59,
    "end": 119.77,
    "text": "大それた才能なんてこっちからお断りだ"
  },
  {
    "start": 119.77,
    "end": 126.37,
    "text": "バードエンドなんかじゃないそれなりの幸せで"
  },
  {
    "start": 126.37,
    "end": 130.36,
    "text": "決められたレールを保っても"
  },
  {
    "start": 130.75,
    "end": 136.76,
    "text": "悪くはないんだろうけどそれだけじゃつまらないから"
  },
  {
    "start": 157.91,
    "end": 162.83,
    "text": "走れ最低限でも止まらなくそれでいいから"
  },
  {
    "start": 162.83,
    "end": 168.13,
    "text": "後ろで指さす奴らはほっとけ"
  },
  {
    "start": 168.13,
    "end": 173.21,
    "text": "上質な人生なんてもう特に諦めたら"
  },
  {
    "start": 173.21,
    "end": 180.08,
    "text": "エンドロールなんかじゃない生き様で刻んでやれ"
  },
  {
    "start": 183.89,
    "end": 188.0,
    "text": "くだらない人生の最後の一手を"
  },
  {
    "start": 189.63,
    "end": 190.44,
    "text": "今"
  }
]