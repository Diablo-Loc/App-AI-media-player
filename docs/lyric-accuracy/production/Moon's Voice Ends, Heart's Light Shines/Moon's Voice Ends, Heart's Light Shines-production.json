[
  {
    "start": 0.0,
    "end": 2.3,
    "text": "字幕志愿者"
  },
  {
    "start": 14.71,
    "end": 25.0,
    "text": "月光會不會記得今夜一顆心去的彼此緣"
  },
  {
    "start": 27.93,
    "end": 32.85,
    "text": "该怎样认真轻轻的爱恋"
  },
  {
    "start": 32.85,
    "end": 40.17,
    "text": "才敢见这人世间本最寻常的一面"
  },
  {
    "start": 40.17,
    "end": 46.65,
    "text": "谁助理一泪眼一若眼一笑眼"
  },
  {
    "start": 46.65,
    "end": 50.15,
    "text": "望著你那皎潔"
  },
  {
    "start": 50.15,
    "end": 55.65,
    "text": "得用的模型如潮蟲卻屋簷"
  },
  {
    "start": 55.65,
    "end": 59.25,
    "text": "花前讓你走遠"
  },
  {
    "start": 59.25,
    "end": 64.71,
    "text": "至此間我直覺流年應有限"
  },
  {
    "start": 64.71,
    "end": 68.01,
    "text": "而你要向前追追遠"
  },
  {
    "start": 68.01,
    "end": 71.77,
    "text": "無畏絕望期間"
  },
  {
    "start": 71.77,
    "end": 74.95,
    "text": "去海天去原野"
  },
  {
    "start": 74.95,
    "end": 77.95,
    "text": "只剩孤舍孤雲煙"
  },
  {
    "start": 77.95,
    "end": 79.93,
    "text": "我只復回看"
  },
  {
    "start": 79.93,
    "end": 82.35,
    "text": "回憶從未停在起點"
  },
  {
    "start": 82.35,
    "end": 86.54,
    "text": "只在你心間你心間"
  },
  {
    "start": 92.65,
    "end": 96.15,
    "text": "誰站在原地肅望"
  },
  {
    "start": 96.15,
    "end": 102.68,
    "text": "從前這條路比夢境更低绵绵"
  },
  {
    "start": 104.09,
    "end": 105.3,
    "text": "誓言了"
  },
  {
    "start": 106.19,
    "end": 108.17,
    "text": "终怨终念"
  },
  {
    "start": 108.17,
    "end": 110.15,
    "text": "已早已成绝"
  },
  {
    "start": 110.15,
    "end": 113.01,
    "text": "从此却看见"
  },
  {
    "start": 113.01,
    "end": 114.63,
    "text": "青云殆月"
  },
  {
    "start": 114.63,
    "end": 123.06,
    "text": "惊鸿一明天谁的笑已婉然已释然"
  },
  {
    "start": 123.15,
    "end": 126.28,
    "text": "已罕然望着你"
  },
  {
    "start": 126.53,
    "end": 129.41,
    "text": "连美影都勇敢"
  },
  {
    "start": 129.41,
    "end": 130.99,
    "text": "我心如潮"
  },
  {
    "start": 130.99,
    "end": 134.65,
    "text": "却已无言送你走远"
  },
  {
    "start": 134.65,
    "end": 137.45,
    "text": "终止相隔这人间"
  },
  {
    "start": 137.45,
    "end": 140.75,
    "text": "这次见我只觉"
  },
  {
    "start": 140.75,
    "end": 142.63,
    "text": "有念应有卷"
  },
  {
    "start": 142.63,
    "end": 147.11,
    "text": "而你要相见追着远不畏惧"
  },
  {
    "start": 147.11,
    "end": 151.06,
    "text": "忘记一切这海天"
  },
  {
    "start": 151.61,
    "end": 153.73,
    "text": "只愿也只剩"
  },
  {
    "start": 153.73,
    "end": 155.94,
    "text": "不舍不远言"
  },
  {
    "start": 156.49,
    "end": 160.17,
    "text": "不知不悲看回忆从未停在凄连"
  },
  {
    "start": 160.17,
    "end": 165.02,
    "text": "只在你心间你心间"
  },
  {
    "start": 182.05,
    "end": 184.64,
    "text": "一去千年"
  },
  {
    "start": 184.81,
    "end": 187.75,
    "text": "换你在相守梦中"
  },
  {
    "start": 187.75,
    "end": 193.29,
    "text": "我们的琴弦片刻不欠你我重回"
  },
  {
    "start": 193.29,
    "end": 196.84,
    "text": "重逢在遥远的岁月"
  },
  {
    "start": 198.73,
    "end": 200.91,
    "text": "彼此间"
  },
  {
    "start": 200.91,
    "end": 204.15,
    "text": "我只觉留念应有限"
  },
  {
    "start": 204.15,
    "end": 207.43,
    "text": "而你呀向前追着远"
  },
  {
    "start": 207.43,
    "end": 212.31,
    "text": "不畏惧忘记一切旧世界"
  },
  {
    "start": 212.31,
    "end": 215.71,
    "text": "朝月夜已熄戒"
  },
  {
    "start": 215.71,
    "end": 217.73,
    "text": "也能活半天"
  },
  {
    "start": 217.73,
    "end": 219.37,
    "text": "多数年眉眼"
  },
  {
    "start": 219.37,
    "end": 220.99,
    "text": "那故事那些年"
  },
  {
    "start": 220.99,
    "end": 224.02,
    "text": "毁掉在你记念的"
  },
  {
    "start": 224.26,
    "end": 226.08,
    "text": "这那天"
  },
  {
    "start": 227.88,
    "end": 232.33,
    "text": "前路某边任心向幻望前天如光魂如月"
  },
  {
    "start": 232.33,
    "end": 235.8,
    "text": "不得苍生永远"
  },
  {
    "start": 246.53,
    "end": 246.8,
    "text": "由 Am ara."
  },
  {
    "start": 252.85,
    "end": 254.14,
    "text": "org 社群提供的字幕"
  }
]