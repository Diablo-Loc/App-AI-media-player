{
  "media_id": "probe-0",
  "original_name": "Moon's Voice Ends, Heart's Light Shines",
  "segments": [
    {
      "start": 0.0,
      "end": 2.3,
      "jp": "字幕志愿者",
      "en": "",
      "vi": ""
    },
    {
      "start": 14.71,
      "end": 25.0,
      "jp": "月光會不會記得今夜一顆心去的彼此緣",
      "en": "",
      "vi": ""
    },
    {
      "start": 27.93,
      "end": 32.85,
      "jp": "该怎样认真轻轻的爱恋",
      "en": "",
      "vi": ""
    },
    {
      "start": 32.85,
      "end": 40.17,
      "jp": "才敢见这人世间本最寻常的一面",
      "en": "",
      "vi": ""
    },
    {
      "start": 40.17,
      "end": 46.65,
      "jp": "谁助理一泪眼一若眼一笑眼",
      "en": "",
      "vi": ""
    },
    {
      "start": 46.65,
      "end": 50.15,
      "jp": "望著你那皎潔",
      "en": "",
      "vi": ""
    },
    {
      "start": 50.15,
      "end": 55.65,
      "jp": "得用的模型如潮蟲卻屋簷",
      "en": "",
      "vi": ""
    },
    {
      "start": 55.65,
      "end": 59.25,
      "jp": "花前讓你走遠",
      "en": "",
      "vi": ""
    },
    {
      "start": 59.25,
      "end": 64.71,
      "jp": "至此間我直覺流年應有限",
      "en": "",
      "vi": ""
    },
    {
      "start": 64.71,
      "end": 68.01,
      "jp": "而你要向前追追遠",
      "en": "",
      "vi": ""
    },
    {
      "start": 68.01,
      "end": 71.77,
      "jp": "無畏絕望期間",
      "en": "",
      "vi": ""
    },
    {
      "start": 71.77,
      "end": 74.95,
      "jp": "去海天去原野",
      "en": "",
      "vi": ""
    },
    {
      "start": 74.95,
      "end": 77.95,
      "jp": "只剩孤舍孤雲煙",
      "en": "",
      "vi": ""
    },
    {
      "start": 77.95,
      "end": 79.93,
      "jp": "我只復回看",
      "en": "",
      "vi": ""
    },
    {
      "start": 79.93,
      "end": 82.35,
      "jp": "回憶從未停在起點",
      "en": "",
      "vi": ""
    },
    {
      "start": 82.35,
      "end": 86.54,
      "jp": "只在你心間你心間",
      "en": "",
      "vi": ""
    },
    {
      "start": 92.65,
      "end": 96.15,
      "jp": "誰站在原地肅望",
      "en": "",
      "vi": ""
    },
    {
      "start": 96.15,
      "end": 102.68,
      "jp": "從前這條路比夢境更低绵绵",
      "en": "",
      "vi": ""
    },
    {
      "start": 104.09,
      "end": 105.3,
      "jp": "誓言了",
      "en": "",
      "vi": ""
    },
    {
      "start": 106.19,
      "end": 108.17,
      "jp": "终怨终念",
      "en": "",
      "vi": ""
    },
    {
      "start": 108.17,
      "end": 110.15,
      "jp": "已早已成绝",
      "en": "",
      "vi": ""
    },
    {
      "start": 110.15,
      "end": 113.01,
      "jp": "从此却看见",
      "en": "",
      "vi": ""
    },
    {
      "start": 113.01,
      "end": 114.63,
      "jp": "青云殆月",
      "en": "",
      "vi": ""
    },
    {
      "start": 114.63,
      "end": 123.06,
      "jp": "惊鸿一明天谁的笑已婉然已释然",
      "en": "",
      "vi": ""
    },
    {
      "start": 123.15,
      "end": 126.28,
      "jp": "已罕然望着你",
      "en": "",
      "vi": ""
    },
    {
      "start": 126.53,
      "end": 129.41,
      "jp": "连美影都勇敢",
      "en": "",
      "vi": ""
    },
    {
      "start": 129.41,
      "end": 130.99,
      "jp": "我心如潮",
      "en": "",
      "vi": ""
    },
    {
      "start": 130.99,
      "end": 134.65,
      "jp": "却已无言送你走远",
      "en": "",
      "vi": ""
    },
    {
      "start": 134.65,
      "end": 137.45,
      "jp": "终止相隔这人间",
      "en": "",
      "vi": ""
    },
    {
      "start": 137.45,
      "end": 140.75,
      "jp": "这次见我只觉",
      "en": "",
      "vi": ""
    },
    {
      "start": 140.75,
      "end": 142.63,
      "jp": "有念应有卷",
      "en": "",
      "vi": ""
    },
    {
      "start": 142.63,
      "end": 147.11,
      "jp": "而你要相见追着远不畏惧",
      "en": "",
      "vi": ""
    },
    {
      "start": 147.11,
      "end": 151.06,
      "jp": "忘记一切这海天",
      "en": "",
      "vi": ""
    },
    {
      "start": 151.61,
      "end": 153.73,
      "jp": "只愿也只剩",
      "en": "",
      "vi": ""
    },
    {
      "start": 153.73,
      "end": 155.94,
      "jp": "不舍不远言",
      "en": "",
      "vi": ""
    },
    {
      "start": 156.49,
      "end": 160.17,
      "jp": "不知不悲看回忆从未停在凄连",
      "en": "",
      "vi": ""
    },
    {
      "start": 160.17,
      "end": 165.02,
      "jp": "只在你心间你心间",
      "en": "",
      "vi": ""
    },
    {
      "start": 182.05,
      "end": 184.64,
      "jp": "一去千年",
      "en": "",
      "vi": ""
    },
    {
      "start": 184.81,
      "end": 187.75,
      "jp": "换你在相守梦中",
      "en": "",
      "vi": ""
    },
    {
      "start": 187.75,
      "end": 193.29,
      "jp": "我们的琴弦片刻不欠你我重回",
      "en": "",
      "vi": ""
    },
    {
      "start": 193.29,
      "end": 196.84,
      "jp": "重逢在遥远的岁月",
      "en": "",
      "vi": ""
    },
    {
      "start": 198.73,
      "end": 200.91,
      "jp": "彼此间",
      "en": "",
      "vi": ""
    },
    {
      "start": 200.91,
      "end": 204.15,
      "jp": "我只觉留念应有限",
      "en": "",
      "vi": ""
    },
    {
      "start": 204.15,
      "end": 207.43,
      "jp": "而你呀向前追着远",
      "en": "",
      "vi": ""
    },
    {
      "start": 207.43,
      "end": 212.31,
      "jp": "不畏惧忘记一切旧世界",
      "en": "",
      "vi": ""
    },
    {
      "start": 212.31,
      "end": 215.71,
      "jp": "朝月夜已熄戒",
      "en": "",
      "vi": ""
    },
    {
      "start": 215.71,
      "end": 217.73,
      "jp": "也能活半天",
      "en": "",
      "vi": ""
    },
    {
      "start": 217.73,
      "end": 219.37,
      "jp": "多数年眉眼",
      "en": "",
      "vi": ""
    },
    {
      "start": 219.37,
      "end": 220.99,
      "jp": "那故事那些年",
      "en": "",
      "vi": ""
    },
    {
      "start": 220.99,
      "end": 224.02,
      "jp": "毁掉在你记念的",
      "en": "",
      "vi": ""
    },
    {
      "start": 224.26,
      "end": 226.08,
      "jp": "这那天",
      "en": "",
      "vi": ""
    },
    {
      "start": 227.88,
      "end": 232.33,
      "jp": "前路某边任心向幻望前天如光魂如月",
      "en": "",
      "vi": ""
    },
    {
      "start": 232.33,
      "end": 235.8,
      "jp": "不得苍生永远",
      "en": "",
      "vi": ""
    },
    {
      "start": 246.53,
      "end": 246.8,
      "jp": "由 Am ara.",
      "en": "",
      "vi": ""
    },
    {
      "start": 252.85,
      "end": 254.14,
      "jp": "org 社群提供的字幕",
      "en": "",
      "vi": ""
    }
  ]
}