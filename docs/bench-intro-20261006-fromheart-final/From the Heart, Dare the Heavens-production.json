[
  {
    "start": 21.174,
    "end": 25.11,
    "text": "风斗落雪树三股炙鸭声"
  },
  {
    "start": 25.11,
    "end": 29.09,
    "text": "墨镜云燃出掩埋着生命温热的心脏"
  },
  {
    "start": 29.09,
    "end": 32.06,
    "text": "一步一风景一步一风景"
  },
  {
    "start": 33.01,
    "end": 36.11,
    "text": "未完的誓言沉入安静"
  },
  {
    "start": 36.11,
    "end": 38.83,
    "text": "誓言棋子散落棋盘"
  },
  {
    "start": 38.83,
    "end": 40.77,
    "text": "相识自尽沉淡"
  },
  {
    "start": 40.77,
    "end": 44.72,
    "text": "扬开一卷无声的波澜"
  },
  {
    "start": 44.98,
    "end": 46.61,
    "text": "等清风去牵动"
  },
  {
    "start": 46.61,
    "end": 52.25,
    "text": "天干地支并作笑抱着迷雾行逐命运的轨迹深水的轮廓"
  },
  {
    "start": 52.25,
    "end": 56.37,
    "text": "千江上月华春归流入深海"
  },
  {
    "start": 56.37,
    "end": 60.37,
    "text": "幻境上花影總會落至塵埃"
  },
  {
    "start": 60.37,
    "end": 64.15,
    "text": "前路隨夢朦朧濃霧作千山"
  },
  {
    "start": 64.15,
    "end": 68.04,
    "text": "無相拒不踏隨著滿塵的一彩"
  },
  {
    "start": 75.59,
    "end": 79.73,
    "text": "為樓索尋寂渴望不可及"
  },
  {
    "start": 79.73,
    "end": 83.63,
    "text": "執念的影響漸漸的光加不照看終極"
  },
  {
    "start": 83.63,
    "end": 87.53,
    "text": "在風景下碎落塵流裡"
  },
  {
    "start": 87.53,
    "end": 91.51,
    "text": "無數個自己從好莫名浮跡"
  },
  {
    "start": 91.51,
    "end": 93.43,
    "text": "一切都我從未照不點亮"
  },
  {
    "start": 93.43,
    "end": 95.43,
    "text": "撐不開曾為情深敗類點槍"
  },
  {
    "start": 95.43,
    "end": 97.27,
    "text": "牽掌走走過壞心的現象"
  },
  {
    "start": 97.27,
    "end": 99.23,
    "text": "結碎這臉掌上我唯一的選項"
  },
  {
    "start": 99.23,
    "end": 101.25,
    "text": "永恆只在瞬間當中徘徊"
  },
  {
    "start": 101.25,
    "end": 103.25,
    "text": "寂靜無聲處在停留你以來"
  },
  {
    "start": 103.25,
    "end": 105.09,
    "text": "不曾不回明智不過道場"
  },
  {
    "start": 105.09,
    "end": 107.2,
    "text": "轉換人生飄揚著這心裡的倔強"
  },
  {
    "start": 110.55,
    "end": 114.95,
    "text": "七字散落期盼相识自尽神叹"
  },
  {
    "start": 114.95,
    "end": 118.65,
    "text": "扬开一转无声的波澜"
  },
  {
    "start": 118.65,
    "end": 122.63,
    "text": "人人都用冲断过着心中分盘"
  },
  {
    "start": 122.63,
    "end": 126.01,
    "text": "可有人偏要统统拆穿"
  },
  {
    "start": 126.01,
    "end": 130.45,
    "text": "千江上月花终归流入深海"
  },
  {
    "start": 130.45,
    "end": 134.49,
    "text": "万情生花影总归落至尘埃"
  },
  {
    "start": 134.49,
    "end": 138.25,
    "text": "尖露飞梦融入暖雾所牵手"
  },
  {
    "start": 138.25,
    "end": 142.14,
    "text": "我将一步踏碎这漫长的一带"
  },
  {
    "start": 142.69,
    "end": 149.33,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 150.09,
    "end": 154.28,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 160.09,
    "end": 161.96,
    "text": "啦啦啦啦啦"
  },
  {
    "start": 164.49,
    "end": 174.19,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 174.19,
    "end": 179.07,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 179.07,
    "end": 181.27,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 181.27,
    "end": 184.47,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 184.47,
    "end": 184.49,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 184.49,
    "end": 185.11,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 185.11,
    "end": 185.17,
    "text": "啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦啦"
  },
  {
    "start": 185.17,
    "end": 188.79,
    "text": "不曾低步踏碎这漫长的一彩"
  },
  {
    "start": 188.79,
    "end": 192.87,
    "text": "原来万物兜兜转转到头来"
  },
  {
    "start": 192.87,
    "end": 196.77,
    "text": "是一颗几秒不时间的留白"
  },
  {
    "start": 196.77,
    "end": 200.65,
    "text": "天地是我的掌纹轻轻弹牌"
  },
  {
    "start": 200.65,
    "end": 202.33,
    "text": "当我和江湘万山万海"
  },
  {
    "start": 202.33,
    "end": 204.33,
    "text": "天高江湘融于这一白"
  },
  {
    "start": 204.33,
    "end": 208.45,
    "text": "原来万物兜兜转转到头来"
  },
  {
    "start": 208.45,
    "end": 212.37,
    "text": "是一颗几秒不时间的留白"
  },
  {
    "start": 212.37,
    "end": 216.27,
    "text": "眼底是我的掌紋輕輕彈開"
  },
  {
    "start": 216.27,
    "end": 217.97,
    "text": "當我和朝星幻想晚來"
  },
  {
    "start": 217.97,
    "end": 220.0,
    "text": "拳頭將手農於這一杯"
  }
]