{
  "cues": [
    {
      "start": 5.6800000000000015,
      "end": 9.129999999999999,
      "text": "くだらない人生の最後の一手"
    },
    {
      "start": 10.2,
      "end": 14.35,
      "text": "エンドロールに名前がなくとも"
    },
    {
      "start": 28.959999999999997,
      "end": 30.08,
      "text": "壊れた世界"
    },
    {
      "start": 30.2,
      "end": 34.614999999999995,
      "text": "息を吸って解けた靴紐を結んだ"
    },
    {
      "start": 34.735,
      "end": 39.27,
      "text": "理屈な言葉あたりでも足を止めないよ"
    },
    {
      "start": 39.7,
      "end": 43.830000000000005,
      "text": "つるぼけた地図を頼りにいこう"
    },
    {
      "start": 44.900000000000006,
      "end": 49.71,
      "text": "隣の芝生が青く見えても"
    },
    {
      "start": 51.28,
      "end": 56.05500000000001,
      "text": "走り最低限でも止まらなきゃそれでいいから"
    },
    {
      "start": 56.17500000000001,
      "end": 61.394999999999996,
      "text": "後ろで指差す奴らはほっとけ"
    },
    {
      "start": 61.515,
      "end": 66.655,
      "text": "消失な人生なんてもう特に諦めたら"
    },
    {
      "start": 66.775,
      "end": 69.175,
      "text": "エンドロールなんかじゃない"
    },
    {
      "start": 69.295,
      "end": 73.19,
      "text": "生き様で刻んでやれ"
    },
    {
      "start": 82.06,
      "end": 87.35,
      "text": "一人がいいってどこか強がってみせた"
    },
    {
      "start": 88.02000000000001,
      "end": 92.83,
      "text": "主人公じゃないから見合わないのに"
    },
    {
      "start": 93.35,
      "end": 97.155,
      "text": "けれど千点万か正解はいいぞ"
    },
    {
      "start": 97.275,
      "end": 103.22999999999999,
      "text": "そう都合主義ならまかり通すだよ"
    },
    {
      "start": 104.64,
      "end": 109.675,
      "text": "二重人生なんかそういうものっては生きらないで"
    },
    {
      "start": 109.795,
      "end": 114.815,
      "text": "泥まみれの生き方でもいいんだ"
    },
    {
      "start": 114.935,
      "end": 119.99499999999999,
      "text": "大それた才能なんてこっちからお断りだ"
    },
    {
      "start": 120.115,
      "end": 122.63499999999999,
      "text": "バードエンドなんかじゃない"
    },
    {
      "start": 122.755,
      "end": 126.595,
      "text": "それなりの幸せで"
    },
    {
      "start": 126.715,
      "end": 130.55,
      "text": "決められたレールを保っても"
    },
    {
      "start": 131.0,
      "end": 133.615,
      "text": "悪くはないんだろうけど"
    },
    {
      "start": 133.735,
      "end": 136.95000000000002,
      "text": "それだけじゃつまらないから"
    },
    {
      "start": 158.16,
      "end": 163.055,
      "text": "走れ最低限でも止まらなくそれでいいから"
    },
    {
      "start": 163.175,
      "end": 168.35500000000002,
      "text": "後ろで指さす奴らはほっとけ"
    },
    {
      "start": 168.47500000000002,
      "end": 173.435,
      "text": "上質な人生なんてもう特に諦めたら"
    },
    {
      "start": 173.555,
      "end": 176.09499999999997,
      "text": "エンドロールなんかじゃない"
    },
    {
      "start": 176.21499999999997,
      "end": 180.27,
      "text": "生き様で刻んでやれ"
    },
    {
      "start": 184.14,
      "end": 188.19,
      "text": "くだらない人生の最後の一手を"
    }
  ],
