{
  "cues": [
    {
      "start": 5.6800000000000015,
      "end": 9.129999999999999,
      "text": "くだらない人生の最後の一手"
    },
    {
      "start": 10.2,
      "end": 14.35,
      "text": "エンドロールに名前がなくとも"
    },
    {
      "start": 28.959999999999997,
      "end": 29.849999999999998,
      "text": "壊れた"
    },
    {
      "start": 30.2,
      "end": 34.575,
      "text": "息を吸って解けた靴紐を結んだ"
    },
    {
      "start": 34.69500000000001,
      "end": 39.175,
      "text": "陸心なことばかりでも足を止めないよ"
    },
    {
      "start": 39.295,
      "end": 43.85,
      "text": "つるぼけた地図を頼りにいこう"
    },
    {
      "start": 44.83,
      "end": 49.720000000000006,
      "text": "隣の芝生が青く見えても"
    },
    {
      "start": 52.050000000000004,
      "end": 56.14000000000001,
      "text": "死に最低限でも止まらなきゃそれでいいから"
    },
    {
      "start": 56.830000000000005,
      "end": 61.405,
      "text": "後ろで指差す奴らはほっとけ"
    },
    {
      "start": 62.050000000000004,
      "end": 66.625,
      "text": "上質な人生なんてもう特に諦めたら"
    },
    {
      "start": 66.745,
      "end": 69.205,
      "text": "エンドロールなんかじゃない"
    },
    {
      "start": 69.325,
      "end": 73.3,
      "text": "生き様で刻んで割れ"
    },
    {
      "start": 82.05,
      "end": 87.33999999999999,
      "text": "一人がいいってどこか強がってみせた"
    },
    {
      "start": 88.00999999999999,
      "end": 92.85999999999999,
      "text": "主人公じゃないから似合わないのに"
    },
    {
      "start": 93.33,
      "end": 95.26499999999999,
      "text": "けれど先天万家"
    },
    {
      "start": 95.38499999999999,
      "end": 97.33999999999999,
      "text": "世界がいっそ"
    },
    {
      "start": 98.17,
      "end": 99.68499999999999,
      "text": "ご都合"
    },
    {
      "start": 99.80499999999999,
      "end": 100.505,
      "text": "主義なら"
    },
    {
      "start": 100.625,
      "end": 103.11999999999999,
      "text": "まかり通すかよ"
    },
    {
      "start": 112.05,
      "end": 114.76499999999999,
      "text": "生き方でもいいんだ"
    },
    {
      "start": 114.88499999999999,
      "end": 117.24499999999999,
      "text": "大それた才能なんて"
    },
    {
      "start": 117.365,
      "end": 119.96499999999999,
      "text": "こっちからお断りだ"
    },
    {
      "start": 122.05,
      "end": 126.54499999999999,
      "text": "それなりの幸せで"
    },
    {
      "start": 126.66499999999999,
      "end": 130.505,
      "text": "決められたレールをたどっても"
    },
    {
      "start": 132.04999999999998,
      "end": 133.60500000000002,
      "text": "はないんだろうけど"
    },
    {
      "start": 133.72500000000002,
      "end": 137.04,
      "text": "それだけじゃつまらないから"
    },
    {
      "start": 158.20999999999998,
      "end": 163.12,
      "text": "走れ最低限でも止まらなくそれでいいから"
    },
    {
      "start": 172.04999999999998,
      "end": 176.20000000000002,
      "text": "諦めたらエンドロールなんかじゃない"
    },
    {
      "start": 176.48999999999998,
      "end": 180.26000000000002,
      "text": "生きざまって刻んでやれ"
    },
    {
      "start": 184.24999999999997,
      "end": 188.20000000000002,
      "text": "くだらない人生の最後の一手を"
    }
  ],
