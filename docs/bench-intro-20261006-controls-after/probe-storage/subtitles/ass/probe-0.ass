Dialogue: 0,0:00:12.05,0:00:16.15,Main,,0,0,0,,初音ミク歌初音ミク
Dialogue: 0,0:00:16.15,0:00:18.61,Main,,0,0,0,,歌初音ミク
Dialogue: 0,0:00:18.61,0:00:19.29,Main,,0,0,0,,歌初音ミク
Dialogue: 0,0:00:19.29,0:00:21.07,Main,,0,0,0,,歌初音ミク
Dialogue: 0,0:00:21.07,0:00:21.87,Main,,0,0,0,,歌初音ミク
Dialogue: 0,0:00:21.87,0:00:24.13,Main,,0,0,0,,歌初音ミク
Dialogue: 0,0:00:24.13,0:00:27.37,Main,,0,0,0,,歌初音ミク
Dialogue: 0,0:00:27.37,0:00:29.93,Main,,0,0,0,,歌初音ミク
Dialogue: 0,0:00:29.93,0:00:33.27,Main,,0,0,0,,どっちだって届いなさいよ
Dialogue: 0,0:00:33.27,0:00:38.47,Main,,0,0,0,,君がいなくちゃなんか足りない私じゃない
Dialogue: 0,0:00:38.47,0:00:41.59,Main,,0,0,0,,ぶつかることでも
Dialogue: 0,0:00:41.59,0:00:44.43,Main,,0,0,0,,どこよく刻まれると
Dialogue: 0,0:00:44.43,0:00:46.57,Main,,0,0,0,,秘密のダイアリー
Dialogue: 0,0:00:46.57,0:00:48.93,Main,,0,0,0,,ベリータッチエンカウント知らなかった
Dialogue: 0,0:00:48.93,0:00:51.71,Main,,0,0,0,,優しさちょっと古いんじゃない
Dialogue: 0,0:00:51.71,0:00:54.39,Main,,0,0,0,,天元天界赤くなった
Dialogue: 0,0:00:54.39,0:00:57.23,Main,,0,0,0,,ほっぺたなんか見せたくない
Dialogue: 0,0:00:57.23,0:00:59.85,Main,,0,0,0,,メリー・デス・エン・キャン削ぎ出した
Dialogue: 0,0:00:59.85,0:01:03.53,Main,,0,0,0,,ハートはダブルそのムースはブルーリー
Dialogue: 0,0:01:03.53,0:01:05.25,Main,,0,0,0,,挑めさあ一歩
Dialogue: 0,0:01:05.25,0:01:08.05,Main,,0,0,0,,ときめき混ざるアドベンチャー
Dialogue: 0,0:01:08.05,0:01:11.11,Main,,0,0,0,,ふたつの意味でのアタック
Dialogue: 0,0:01:11.11,0:01:12.94,Main,,0,0,0,,受け止めて
Dialogue: 0,0:01:13.83,0:01:16.83,Main,,0,0,0,,連戦連敗ボカスカしたい
Dialogue: 0,0:01:16.83,0:01:19.11,Main,,0,0,0,,ジャンケンアイコンソテリーフォー
Dialogue: 0,0:01:19.11,0:01:22.27,Main,,0,0,0,,連戦連敗ボカスカしたい
Dialogue: 0,0:01:22.27,0:01:24.78,Main,,0,0,0,,ジャンケン次はソテリーフォー
Dialogue: 0,0:01:27.23,0:01:32.39,Main,,0,0,0,,気づいちゃったんだ私甘い展開の兆し
Dialogue: 0,0:01:32.39,0:01:37.79,Main,,0,0,0,,生まれ変わったように惹かれ合う光
Dialogue: 0,0:01:37.79,0:01:43.44,Main,,0,0,0,,迷い込んじゃった君とこの青春ってバンジョン
Dialogue: 0,0:01:43.75,0:01:49.37,Main,,0,0,0,,守って守られてどんな勇者だってキュンとなっちゃう
Dialogue: 0,0:01:49.37,0:01:54.49,Main,,0,0,0,,次から次へとっと開いする未来
Dialogue: 0,0:01:54.49,0:02:00.07,Main,,0,0,0,,レベル上げてもやっぱ君といる限り
Dialogue: 0,0:02:00.07,0:02:02.57,Main,,0,0,0,,避けられないラブとメイン
Dialogue: 0,0:02:02.57,0:02:05.01,Main,,0,0,0,,ベリーパンエンガー吐きなんかない
Dialogue: 0,0:02:05.01,0:02:07.65,Main,,0,0,0,,笑顔はほんとずるいんじゃない
Dialogue: 0,0:02:07.65,0:02:10.41,Main,,0,0,0,,百戦で真っ直ぐ負けば
Dialogue: 0,0:02:10.41,0:02:13.17,Main,,0,0,0,,好きはないだけど好きしかない
Dialogue: 0,0:02:13.17,0:02:15.71,Main,,0,0,0,,ベリーキューエンガー変わりだした
Dialogue: 0,0:02:15.71,0:02:18.82,Main,,0,0,0,,ハートはたぶんそのままじゃない
Dialogue: 0,0:02:19.43,0:02:21.17,Main,,0,0,0,,ならば飛び込むわ
Dialogue: 0,0:02:21.17,0:02:24.11,Main,,0,0,0,,伝説にない隠しイベント
Dialogue: 0,0:02:24.11,0:02:29.06,Main,,0,0,0,,こんなにも無謀になったくさい子でしょ
Dialogue: 0,0:02:42.91,0:02:46.43,Main,,0,0,0,,だって君はこの心で
Dialogue: 0,0:02:46.43,0:02:48.62,Main,,0,0,0,,吹き降る魔王だ
Dialogue: 0,0:02:49.65,0:02:52.23,Main,,0,0,0,,ベリーバーエン感謝なかった
Dialogue: 0,0:02:52.23,0:02:55.22,Main,,0,0,0,,優しさちょっとずるいんじゃない?
Dialogue: 0,0:02:55.37,0:02:57.79,Main,,0,0,0,,宣言的かいあたくなった
Dialogue: 0,0:02:57.79,0:03:00.63,Main,,0,0,0,,ほうせたなんか見せたくない
Dialogue: 0,0:03:00.63,0:03:03.27,Main,,0,0,0,,メディクス笑顔研ぎ出した
Dialogue: 0,0:03:03.27,0:03:08.31,Main,,0,0,0,,ハートはダブそう無茶ぶるみ挑め最後
Dialogue: 0,0:03:08.31,0:03:11.67,Main,,0,0,0,,ときめき混ざる後で歌う
Dialogue: 0,0:03:11.67,0:03:16.36,Main,,0,0,0,,ふたつの意味でのアタック受け止めて
Dialogue: 0,0:03:17.13,0:03:20.23,Main,,0,0,0,,連戦連敗ボカス化したい
Dialogue: 0,0:03:20.23,0:03:22.33,Main,,0,0,0,,じゃんけん愛顔ソベリンゴ
Dialogue: 0,0:03:22.33,0:03:25.55,Main,,0,0,0,,連戦連敗僕はクソしたい
Dialogue: 0,0:03:25.55,0:03:28.04,Main,,0,0,0,,じゃんけん次はソベリンゴ