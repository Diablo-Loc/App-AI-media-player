[
  {
    "start": 11.13,
    "end": 16.45,
    "text": "出逢っちゃったんだ二人熱い運命の似合い"
  },
  {
    "start": 16.45,
    "end": 24.63,
    "text": "変わんないまま胸に光る流れ忘忘れれらられないれない君と"
  },
  {
    "start": 24.63,
    "end": 27.5,
    "text": "凄い喧嘩した日 々 も"
  },
  {
    "start": 27.72,
    "end": 29.91,
    "text": "実は宝物"
  },
  {
    "start": 29.91,
    "end": 31.82,
    "text": "どっちだって"
  },
  {
    "start": 33.27,
    "end": 38.47,
    "text": "君がいなくちゃなんか足りない私じゃない"
  },
  {
    "start": 38.47,
    "end": 41.59,
    "text": "ぶつかることでも"
  },
  {
    "start": 41.59,
    "end": 44.43,
    "text": "どこよく刻まれると"
  },
  {
    "start": 44.43,
    "end": 46.57,
    "text": "秘密のダイアリー"
  },
  {
    "start": 46.57,
    "end": 48.93,
    "text": "ベリータッチエンカウント知らなかった"
  },
  {
    "start": 48.93,
    "end": 51.71,
    "text": "優しさちょっと古いんじゃない"
  },
  {
    "start": 51.71,
    "end": 54.39,
    "text": "天元天界赤くなった"
  },
  {
    "start": 54.39,
    "end": 57.23,
    "text": "ほっぺたなんか見せたくない"
  },
  {
    "start": 57.23,
    "end": 59.85,
    "text": "メリー・デス・エン・キャン削ぎ出した"
  },
  {
    "start": 59.85,
    "end": 63.53,
    "text": "ハートはダブルそのムースはブルーリー"
  },
  {
    "start": 63.53,
    "end": 65.25,
    "text": "挑めさあ一歩"
  },
  {
    "start": 65.25,
    "end": 68.05,
    "text": "ときめき混ざるアドベンチャー"
  },
  {
    "start": 68.05,
    "end": 71.11,
    "text": "ふたつの意味でのアタック"
  },
  {
    "start": 71.11,
    "end": 72.94,
    "text": "受け止めて"
  },
  {
    "start": 73.83,
    "end": 76.83,
    "text": "連戦連敗ボカスカしたい"
  },
  {
    "start": 76.83,
    "end": 79.11,
    "text": "ジャンケンアイコンソテリーフォー"
  },
  {
    "start": 79.11,
    "end": 82.27,
    "text": "連戦連敗ボカスカしたい"
  },
  {
    "start": 82.27,
    "end": 84.78,
    "text": "ジャンケン次はソテリーフォー"
  },
  {
    "start": 87.23,
    "end": 92.39,
    "text": "気づいちゃったんだ私甘い展開の兆し"
  },
  {
    "start": 92.39,
    "end": 97.79,
    "text": "生まれ変わったように惹かれ合う光"
  },
  {
    "start": 97.79,
    "end": 103.44,
    "text": "迷い込んじゃった君とこの青春ってバンジョン"
  },
  {
    "start": 103.75,
    "end": 109.37,
    "text": "守って守られてどんな勇者だってキュンとなっちゃう"
  },
  {
    "start": 109.37,
    "end": 114.49,
    "text": "次から次へとっと開いする未来"
  },
  {
    "start": 114.49,
    "end": 120.07,
    "text": "レベル上げてもやっぱ君といる限り"
  },
  {
    "start": 120.07,
    "end": 122.57,
    "text": "避けられないラブとメイン"
  },
  {
    "start": 122.57,
    "end": 125.01,
    "text": "ベリーパンエンガー吐きなんかない"
  },
  {
    "start": 125.01,
    "end": 127.65,
    "text": "笑顔はほんとずるいんじゃない"
  },
  {
    "start": 127.65,
    "end": 130.41,
    "text": "百戦で真っ直ぐ負けば"
  },
  {
    "start": 130.41,
    "end": 133.17,
    "text": "好きはないだけど好きしかない"
  },
  {
    "start": 133.17,
    "end": 135.71,
    "text": "ベリーキューエンガー変わりだした"
  },
  {
    "start": 135.71,
    "end": 138.82,
    "text": "ハートはたぶんそのままじゃない"
  },
  {
    "start": 139.43,
    "end": 141.17,
    "text": "ならば飛び込むわ"
  },
  {
    "start": 141.17,
    "end": 144.11,
    "text": "伝説にない隠しイベント"
  },
  {
    "start": 144.11,
    "end": 149.06,
    "text": "こんなにも無謀になったくさい子でしょ"
  },
  {
    "start": 162.91,
    "end": 166.43,
    "text": "だって君はこの心で"
  },
  {
    "start": 166.43,
    "end": 168.62,
    "text": "吹き降る魔王だ"
  },
  {
    "start": 169.65,
    "end": 172.23,
    "text": "ベリーバーエン感謝なかった"
  },
  {
    "start": 172.23,
    "end": 175.22,
    "text": "優しさちょっとずるいんじゃない?"
  },
  {
    "start": 175.37,
    "end": 177.79,
    "text": "宣言的かいあたくなった"
  },
  {
    "start": 177.79,
    "end": 180.63,
    "text": "ほうせたなんか見せたくない"
  },
  {
    "start": 180.63,
    "end": 183.27,
    "text": "メディクス笑顔研ぎ出した"
  },
  {
    "start": 183.27,
    "end": 188.31,
    "text": "ハートはダブそう無茶ぶるみ挑め最後"
  },
  {
    "start": 188.31,
    "end": 191.67,
    "text": "ときめき混ざる後で歌う"
  },
  {
    "start": 191.67,
    "end": 196.36,
    "text": "ふたつの意味でのアタック受け止めて"
  },
  {
    "start": 197.13,
    "end": 200.23,
    "text": "連戦連敗ボカス化したい"
  },
  {
    "start": 200.23,
    "end": 202.33,
    "text": "じゃんけん愛顔ソベリンゴ"
  },
  {
    "start": 202.33,
    "end": 205.55,
    "text": "連戦連敗僕はクソしたい"
  },
  {
    "start": 205.55,
    "end": 208.04,
    "text": "じゃんけん次はソベリンゴ"
  }
]