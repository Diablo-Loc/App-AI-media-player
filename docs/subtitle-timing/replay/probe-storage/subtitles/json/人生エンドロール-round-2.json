  "segments": [
    {
      "start": 29.95,
      "end": 34.39,
      "jp": "息を吸って解けた靴紐を結んだ",
      "en": "",
      "vi": ""
    },
    {
      "start": 34.39,
      "end": 39.0,
      "jp": "理屈な言葉あたりでも足を止めないよ",
      "en": "",
      "vi": ""
    },
    {
      "start": 39.45,
      "end": 43.56,
      "jp": "つるぼけた地図を頼りにいこう",
      "en": "",
      "vi": ""
    },
    {
      "start": 44.65,
      "end": 49.44,
      "jp": "隣の芝生が青く見えても",
      "en": "",
      "vi": ""
    },
    {
      "start": 51.03,
      "end": 55.83,
      "jp": "走り最低限でも止まらなきゃそれでいいから",
      "en": "",
      "vi": ""
    },
    {
      "start": 55.83,
      "end": 61.17,
      "jp": "後ろで指差す奴らはほっとけ",
      "en": "",
      "vi": ""
    },
    {
      "start": 61.17,
      "end": 66.43,
      "jp": "消失な人生なんてもう特に諦めたら",
      "en": "",
      "vi": ""
    },
    {
      "start": 66.43,
      "end": 72.92,
      "jp": "エンドロールなんかじゃない生き様で刻んでやれ",
      "en": "",
      "vi": ""
    },
    {
      "start": 81.81,
      "end": 87.08,
      "jp": "一人がいいってどこか強がってみせた",
      "en": "",
      "vi": ""
    },
    {
      "start": 87.77,
      "end": 90.3,
      "jp": "主人公じゃないから",
      "en": "",
      "vi": ""
    },
    {
      "start": 90.53,
      "end": 92.56,
      "jp": "見合わないのに",
      "en": "",
      "vi": ""
    },
    {
      "start": 93.1,
      "end": 96.93,
      "jp": "けれど千点万か正解はいいぞ",
      "en": "",
      "vi": ""
    },
    {
      "start": 96.93,
      "end": 102.96,
      "jp": "そう都合主義ならまかり通すだよ",
      "en": "",
      "vi": ""
    },
    {
      "start": 104.39,
      "end": 109.45,
      "jp": "二重人生なんかそういうものっては生きらないで",
      "en": "",
      "vi": ""
    },
    {
      "start": 109.45,
      "end": 114.59,
      "jp": "泥まみれの生き方でもいいんだ",
      "en": "",
      "vi": ""
    },
    {
      "start": 114.59,
      "end": 119.77,
      "jp": "大それた才能なんてこっちからお断りだ",
      "en": "",
      "vi": ""
    },
    {
      "start": 119.77,
      "end": 126.37,
      "jp": "バードエンドなんかじゃないそれなりの幸せで",
      "en": "",
      "vi": ""
    },
    {
      "start": 126.37,
      "end": 130.28,
      "jp": "決められたレールを保っても",
      "en": "",
      "vi": ""
    },
    {
      "start": 130.75,
      "end": 136.68,
      "jp": "悪くはないんだろうけどそれだけじゃつまらないから",
      "en": "",
      "vi": ""
    },
    {
      "start": 157.91,
      "end": 162.83,
      "jp": "走れ最低限でも止まらなくそれでいいから",
      "en": "",
      "vi": ""
    },
    {
      "start": 162.83,
      "end": 168.13,
      "jp": "後ろで指さす奴らはほっとけ",
      "en": "",
      "vi": ""
    },
    {
      "start": 168.13,
      "end": 173.21,
      "jp": "上質な人生なんてもう特に諦めたら",
      "en": "",
      "vi": ""
    },
    {
      "start": 173.21,
      "end": 180.0,
      "jp": "エンドロールなんかじゃない生き様で刻んでやれ",
      "en": "",
      "vi": ""
    },
    {
      "start": 183.89,
      "end": 187.92,
      "jp": "くだらない人生の最後の一手を",
      "en": "",
      "vi": ""
    },
    {
      "start": 189.63,
      "end": 190.36,
      "jp": "今",
      "en": "",
      "vi": ""
    }
