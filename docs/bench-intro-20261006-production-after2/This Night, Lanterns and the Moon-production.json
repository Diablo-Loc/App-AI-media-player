[
  {
    "start": 16.806,
    "end": 22.95,
    "text": "玉龙银玄鸟此小郎月照细心伤伤有过人潮"
  },
  {
    "start": 22.95,
    "end": 25.85,
    "text": "河仙桥风雨渺"
  },
  {
    "start": 25.85,
    "end": 27.71,
    "text": "一闪投落尘霄"
  },
  {
    "start": 27.71,
    "end": 30.88,
    "text": "世间原来不寂寥"
  },
  {
    "start": 32.72,
    "end": 34.53,
    "text": "眼前花枝頭"
  },
  {
    "start": 34.53,
    "end": 36.27,
    "text": "問心配喜鬧"
  },
  {
    "start": 36.27,
    "end": 38.67,
    "text": "抬頭傾灘快意盡照"
  },
  {
    "start": 38.67,
    "end": 40.9,
    "text": "長夜"
  },
  {
    "start": 41.8,
    "end": 43.67,
    "text": "劫前因緣刀"
  },
  {
    "start": 43.67,
    "end": 47.04,
    "text": "不如隨心皆逍遙"
  },
  {
    "start": 48.22,
    "end": 50.92,
    "text": "往遠方"
  },
  {
    "start": 51.74,
    "end": 54.92,
    "text": "一彩流光"
  },
  {
    "start": 56.2,
    "end": 58.27,
    "text": "誰共上"
  },
  {
    "start": 58.27,
    "end": 62.39,
    "text": "燈火琳瑯相傍"
  },
  {
    "start": 62.39,
    "end": 65.85,
    "text": "眷戀間尋常"
  },
  {
    "start": 65.85,
    "end": 69.84,
    "text": "緣有片刻換魂藏"
  },
  {
    "start": 70.27,
    "end": 73.87,
    "text": "浮浪樹瘋變"
  },
  {
    "start": 73.87,
    "end": 77.54,
    "text": "煙火去寒霜"
  },
  {
    "start": 78.27,
    "end": 81.74,
    "text": "昨天像月光"
  },
  {
    "start": 82.27,
    "end": 87.13,
    "text": "灑下萬千盞燈微笑"
  },
  {
    "start": 87.13,
    "end": 93.44,
    "text": "浩浩悠閃破忘心想"
  },
  {
    "start": 131.39,
    "end": 134.23,
    "text": "只醉月遥红线勾一笑"
  },
  {
    "start": 134.23,
    "end": 136.98,
    "text": "不亦喧嚣麻木缭绕"
  },
  {
    "start": 137.73,
    "end": 139.87,
    "text": "玉盆靠风雨摇"
  },
  {
    "start": 139.87,
    "end": 141.65,
    "text": "挥手慈悲烦扰"
  },
  {
    "start": 141.65,
    "end": 143.4,
    "text": "向来云端"
  },
  {
    "start": 147.11,
    "end": 150.31,
    "text": "眼前花正好溫馨被嬉鬧"
  },
  {
    "start": 150.31,
    "end": 152.82,
    "text": "猜到晴天快已盡早"
  },
  {
    "start": 153.69,
    "end": 157.67,
    "text": "長夜借塵因緣刀"
  },
  {
    "start": 157.67,
    "end": 161.0,
    "text": "不如隨心且逍遙"
  },
  {
    "start": 162.47,
    "end": 164.96,
    "text": "望遠方"
  },
  {
    "start": 165.51,
    "end": 168.96,
    "text": "一彩流光"
  },
  {
    "start": 170.33,
    "end": 176.33,
    "text": "誰共上燈火凌亂相逢"
  },
  {
    "start": 176.33,
    "end": 183.8,
    "text": "卷雲間尋常圓腰片的花魂芳"
  },
  {
    "start": 184.33,
    "end": 191.4,
    "text": "浮揚是烽煉煙火去暗上"
  },
  {
    "start": 192.33,
    "end": 195.68,
    "text": "拖天下月光"
  },
  {
    "start": 196.31,
    "end": 201.27,
    "text": "灑下萬千讓它回響"
  },
  {
    "start": 201.27,
    "end": 207.58,
    "text": "好梦悠长莫忘倾向"
  },
  {
    "start": 208.27,
    "end": 211.64,
    "text": "续人间寻常"
  },
  {
    "start": 211.83,
    "end": 215.75,
    "text": "此去一目一无恙"
  },
  {
    "start": 215.75,
    "end": 224.76,
    "text": "前灯在烽烟拂远方"
  }
]